# Django Secret Key (REQUIRED - Generate a new one for production)
DJANGO_SECRET_KEY=your-super-secret-key-here-change-this-in-production

# Debug Mode (Set to False in production)
DEBUG=True

# Allowed Hosts (Comma-separated list of allowed hosts)
ALLOWED_HOSTS=localhost,127.0.0.1,your-app-name.onrender.com

# For Render: Use the DATABASE_URL provided by Render PostgreSQL service
DATABASE_URL=postgresql://postgres:password@localhost:5432/techmart_db

# Auth0 Domain (REQUIRED for OIDC)
AUTH0_DOMAIN=your-tenant-region.auth0.com

# Auth0 API Identifier
AUTH0_API_IDENTIFIER=https://techmart-api

# Auth0 Algorithms
AUTH0_ALGORITHMS=RS256

# OIDC Client Configuration
OIDC_RP_CLIENT_ID=your-auth0-client-id
OIDC_RP_CLIENT_SECRET=your-auth0-client-secret

# OIDC Endpoints
OIDC_OP_AUTHORIZATION_ENDPOINT=https://your-tenant-region.auth0.com/authorize
OIDC_OP_TOKEN_ENDPOINT=https://your-tenant-region.auth0.com/oauth/token
OIDC_OP_USER_ENDPOINT=https://your-tenant-region.auth0.com/userinfo
OIDC_OP_JWKS_ENDPOINT=https://your-tenant-region.auth0.com/.well-known/jwks.json

# OIDC Redirect URIs
OIDC_RP_REDIRECT_URI=http://localhost:8001/oidc/callback/
OIDC_RP_POST_LOGOUT_REDIRECT_URI=http://localhost:8001/oidc/logout/
OIDC_RP_SCOPES=openid email profile


# Email Configuration
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
ADMIN_EMAIL=admin@techmart.com

# Africa's Talking SMS
AFRICASTALKING_USERNAME=your-africas-talking-username
AFRICASTALKING_API_KEY=your-africas-talking-api-key


# Redis URL (for Celery task queue)
REDIS_URL=redis://localhost:6379/0


# Session Configuration (Set to True in production with HTTPS)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True
